#===== FULLY CONTAINERIZED: watcher itself runs in docker (2026-08-24) =====
#nothing runs on the host python any more. the watcher container starts
#mht_watch itself, and stops/starts the VLM pair on MHT confidence.
#no .venv, no fire_watcher/mht_start.sh, no host python3 needed.

cd /home/student/Documents/projects/wildfire_detection
xhost +local:root

#start the whole thing (watcher -> starts mht_watch -> waits for confidence)
docker compose -f docker-compose_fused_system.yaml --profile watcher up -d fire_watcher

#stop the whole thing (watcher's SIGTERM handler stops the stack + mht_watch)
docker compose -f docker-compose_fused_system.yaml --profile watcher stop fire_watcher

#monitor
docker logs -f fire_watcher_fused
docker logs -f mht_watch_fused
tail -f fire_watcher/watch.jsonl
watch -n2 'docker ps --format "{{.Names}}\t{{.Status}}"'

#force a wake by hand (mht_sim overrides the live MHT scores)
docker exec fire_watcher_fused python3 fire_watcher/mht_sim.py \
  fire_watcher/watcher.sock "0.30:4,0.70:15,0.92:240,0.20:30" --noise 0.05

#full teardown incl. the watcher
docker compose -f docker-compose_fused_system.yaml --profile watcher --profile watch down

#gotchas for the containerized watcher
# - the project MUST be bind-mounted at its identical host path. compose
#   resolves ./data inside the container but the DAEMON resolves it on the
#   host, so the two paths have to be the same string
# - fire_watcher has NO mem_limit on purpose. cgroup v2 charges mmap page
#   cache to the container that faults it in, so a limit would make the
#   kernel evict the very ~2.8GB pre-warm the watcher just did
# - compose calls are scoped to "wildfire_classifier wildfire_detection".
#   a bare `--profile watcher stop` WILL stop the watcher itself
# - stop_grace_period is 60s because compose stop takes 10-13s and the
#   default 10s SIGKILL would cut the shutdown handler off mid-way

