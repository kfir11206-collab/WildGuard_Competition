--- a/packages/llm/awq/build.sh
+++ b/packages/llm/awq/build.sh
@@ -1,6 +1,10 @@
 #!/usr/bin/env bash
 set -ex
 
+# cap compile parallelism: torch cpp_extension/cmake default to all cores and OOM the Jetson
+export MAX_JOBS=1
+export CMAKE_BUILD_PARALLEL_LEVEL=1
+
 echo "Building AWQ ${AWQ_VERSION} (kernels=${AWQ_KERNEL_VERSION})"
 
 git clone --branch=${AWQ_BRANCH} --depth=1 https://github.com/${AWQ_REPO} awq ||
@@ -13,6 +17,9 @@ sed -i \
 
 sed -i 's/==/>=/g' "awq/pyproject.toml"
 
+# nvcc --threads=8 spawns parallel compilers per arch and OOMs the Jetson on the big attention kernel
+sed -i "s|--threads=8|--threads=1|" awq/awq/kernels/setup.py
+
 cat awq/pyproject.toml
 
 uv build --wheel --no-build-isolation --out-dir $PIP_WHEEL_DIR --verbose ./awq
