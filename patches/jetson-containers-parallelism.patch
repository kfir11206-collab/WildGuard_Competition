 ARG BASE_IMAGE
@@ -25,6 +24,7 @@ RUN if [ "$JETSON_UTILS_CMAKE" = "on" ]; then \
         gstreamer1.0-nice \
         libnss-mdns \
 		    libgstrtspserver-1.0-dev \
+		    libgstreamer-plugins-bad1.0-dev \
 		    avahi-utils && \
         rm -rf /var/lib/apt/lists/* && \
         apt-get clean ; \
@@ -34,6 +34,28 @@ ADD https://api.github.com/repos/${JETSON_UTILS_REPO}/git/refs/heads/${JETSON_UT
 
 RUN git clone --branch=${JETSON_UTILS_BRANCH} --depth=1 https://github.com/${JETSON_UTILS_REPO} /opt/jetson-utils
 
+# on ubuntu 24.04 the fallback probe list (2.7 3.6 3.7) min-version-matches python 3.12 repeatedly -> duplicate cmake targets
+RUN sed -i "s|set(PYTHON_BINDING_VERSIONS 2.7 3.6 3.7)|set(PYTHON_BINDING_VERSIONS 3.12)|" /opt/jetson-utils/python/CMakeLists.txt
+
+# CUDA 13 removed nppGetStreamContext(); populate the NppStreamContext manually from device properties
+RUN sed -i \
+    -e "s|NppStreamContext nppStreamContext;|NppStreamContext nppStreamContext = {}; cudaGetDevice(\&nppStreamContext.nCudaDeviceId); cudaDeviceProp nppDevProp; cudaGetDeviceProperties(\&nppDevProp, nppStreamContext.nCudaDeviceId); nppStreamContext.nMultiProcessorCount = nppDevProp.multiProcessorCount; nppStreamContext.nMaxThreadsPerMultiProcessor = nppDevProp.maxThreadsPerMultiProcessor; nppStreamContext.nMaxThreadsPerBlock = nppDevProp.maxThreadsPerBlock; nppStreamContext.nSharedMemPerBlock = nppDevProp.sharedMemPerBlock; nppStreamContext.nCudaDevAttrComputeCapabilityMajor = nppDevProp.major; nppStreamContext.nCudaDevAttrComputeCapabilityMinor = nppDevProp.minor;|" \
+    -e "s|nppGetStreamContext(&nppStreamContext);||" \
+    /opt/jetson-utils/cuda/cudaBayer.cpp
+
+# PyNumpy_ImportNumpy() falls off the end of a non-void function on success; gcc 13 -O3 compiles that into a trap (SIGTRAP on import)
+RUN sed -i "s|import_array();|import_array(); return NULL;|" /opt/jetson-utils/python/bindings/PyNumpy.cpp
+
+# gcc 13 no longer includes stdint.h transitively; add it to every header using fixed-width ints
+RUN grep -rlE "u?int(8|16|32|64)_t" --include="*.h" /opt/jetson-utils | xargs grep -LE "include <(std|c)stdint" | xargs -r sed -i "1i #include <stdint.h>"
+
+# CUDA 13 dropped sm_53/62/72 that v1 hardcodes; build only native Orin sm_87 (the GREATER branches would re-add 72/87)
+RUN sed -i \
+    -e "s|-gencode arch=compute_53,code=sm_53 -gencode arch=compute_62,code=sm_62|-gencode arch=compute_87,code=sm_87|" \
+    -e "s|if(CUDA_VERSION_MAJOR GREATER 9)|if(CUDA_VERSION_MAJOR GREATER 999)|" \
+    -e "s|if(CUDA_VERSION_MAJOR GREATER 10)|if(CUDA_VERSION_MAJOR GREATER 999)|" \
+    /opt/jetson-utils/CMakeLists.txt
+
 RUN if [ "$JETSON_UTILS_CMAKE" = "on" ]; then \
         cd /opt/jetson-utils ; \
         mkdir build ; \
@@ -48,4 +70,12 @@ RUN if [ "$JETSON_UTILS_PIP" = "on" ]; then \
         /opt/venv/bin/python -m pip install --no-cache-dir -e . ; \
     fi
 
+# cmake installs the bindings into system dist-packages; link them into the venv (same pattern as gstreamer's gi)
+RUN if [ "$JETSON_UTILS_CMAKE" = "on" ]; then \
+        PYV=$(/opt/venv/bin/python -c "import sys; print(f'{sys.version_info[0]}.{sys.version_info[1]}')") ; \
+        for m in jetson_utils_python.so jetson_utils jetson Jetson; do \
+            ln -sfn /usr/lib/python${PYV}/dist-packages/$m /opt/venv/lib/python${PYV}/site-packages/$m ; \
+        done ; \
+    fi
+
 RUN LD_LIBRARY_PATH="$LD_LIBRARY_PATH:/usr/local/lib/" /opt/venv/bin/python -c 'import jetson_utils'
